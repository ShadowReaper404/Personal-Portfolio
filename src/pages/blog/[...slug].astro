---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = Object.values(import.meta.glob("../../content/blog/*.md", { eager: true }));
  return posts.map((post) => ({
    params: { slug: post.frontmatter.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { frontmatter } = post;
const Content = post.Content;
---

<BaseLayout title={`${frontmatter.title} — Thevindu Sithujaya`}>
  <Header />
  <main style="padding-top: 120px;">
    <article class="section">
      <div class="container blog-article">
        <div class="blog-article-header">
          <span class="blog-article-date">{frontmatter.date}</span>
          <h1 class="blog-article-title">{frontmatter.title}</h1>
          {frontmatter.tags && (
            <div class="blog-tags" style="justify-content: center;">
              {frontmatter.tags.map((tag) => <span class="blog-tag">{tag}</span>)}
            </div>
          )}
        </div>
        <div class="blog-article-content">
          <Content />
        </div>
        <div class="blog-article-nav">
          <a href="/blog" class="btn btn-outline">← Back to articles</a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .blog-article {
    max-width: 720px;
  }

  .blog-article-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .blog-article-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .blog-article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    margin-top: 16px;
    line-height: 1.2;
  }

  .blog-article-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .blog-article-content h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--text-primary);
    margin: 40px 0 16px;
  }

  .blog-article-content p {
    margin-bottom: 20px;
  }

  .blog-article-content code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--bg-card);
    border: 1px solid var(--border);
  }

  .blog-article-content pre {
    padding: 20px;
    border-radius: var(--radius);
    background: var(--bg-card);
    border: 1px solid var(--border);
    overflow-x: auto;
    margin: 24px 0;
  }

  .blog-article-nav {
    margin-top: 60px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
</style>
